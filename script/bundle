#!/bin/sh
# Wraps a release binary in "Cloudflare GUI.app" and zips it for a release.
#
#   script/bundle <binary> <version> <out-dir>
#
# The app is signed ad hoc, so it's identified by its contents. macOS asks for
# Keychain access again after each update, and Gatekeeper needs a one-time
# "Open Anyway" because the app isn't notarized (see the README).
set -eu
binary="$1"
version="$2"
out="$3"

app="$out/Cloudflare GUI.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary" "$app/Contents/MacOS/cloudflare-gui"

cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Cloudflare GUI</string>
  <key>CFBundleDisplayName</key><string>Cloudflare GUI</string>
  <key>CFBundleIdentifier</key><string>dev.cloudflare-gui</string>
  <key>CFBundleExecutable</key><string>cloudflare-gui</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$version</string>
  <key>CFBundleVersion</key><string>$version</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
</dict>
</plist>
PLIST

codesign --force --sign - "$app"
codesign --verify --strict "$app"

zip="$out/Cloudflare-GUI-$version-macos-universal.zip"
rm -f "$zip"
# ditto keeps the bundle's symlinks, permissions and signature intact.
ditto -c -k --sequesterRsrc --keepParent "$app" "$zip"
shasum -a 256 "$zip" | sed "s|$out/||" >"$zip.sha256"
echo "$zip"
