#!/bin/sh
# The same checks CI runs. Keep this and .github/workflows/check.yml in sync.
set -eu
cd "$(dirname "$0")/.."
cargo fmt --check
cargo clippy --all-targets -- -D warnings
# The devtools build (scripting, demo mode) isn't shipped, but it shouldn't rot.
cargo clippy --all-targets --features devtools -- -D warnings
cargo test
